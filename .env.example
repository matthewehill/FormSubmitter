# Contact Form Automation Tool - Configuration
# Copy this file to .env and fill in your details

# ============================================================================
# REQUIRED SETTINGS - You must fill these in
# ============================================================================

# Your Information
YOUR_NAME=Matt
YOUR_EMAIL=your.email@example.com
YOUR_PHONE=555-123-4567

# ============================================================================
# OPTIONAL SETTINGS - Can use defaults
# ============================================================================

# Message Template
# Use {city} as placeholder for the city name from CSV
MESSAGE_TEMPLATE=Hello, I've been searching all over {city} to see if there's any HVAC company that can help me with something. Can someone reach out?

# 2Captcha API Key (get from https://2captcha.com)
# Leave empty if sites don't have CAPTCHAs
CAPTCHA_API_KEY=

# CSV File Path
CSV_FILE=contacts.csv

# Browser Settings
HEADLESS=true                    # true = invisible, false = see browser
BROWSER_TYPE=chromium           # chromium, firefox, or webkit

# Timing Settings (in seconds)
MIN_DELAY=5                     # Minimum delay between submissions
MAX_DELAY=15                    # Maximum delay between submissions
PAGE_LOAD_TIMEOUT=30           # How long to wait for pages to load
FORM_SUBMIT_WAIT=3             # How long to wait after submitting

# Parallel Processing
MAX_WORKERS=3                   # Number of parallel browser instances (1-5 recommended)

# Logging
LOG_FILE=automation.log
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR

# Progress Tracking
PROGRESS_FILE=progress.json
